DB_URL=postgres://app:change-me@db:5432/app

# Region to cover. The bounding box (south,west,north,east) drives every source.
REGION_ID=wroclaw
REGION_NAME=Wrocław
REGION_BBOX=50.99,16.78,51.22,17.18
REGION_LANG=pl
# NID (national monument register) is filtered by locality name; leave empty to skip it
REGION_MUNICIPALITY=Wrocław
REGION_ADMIN_AREA=dolnośląskie
# buildings older than this year count as German heritage (Wrocław was Breslau until 1945)
REGION_GERMAN_UNTIL=1945

# Comma separated: osm, wikidata, nid, commons, wroclaw_gis (city GIS, Wrocław only)
SOURCES=osm,wikidata,nid,commons,wroclaw_gis

# Cache for downloads and the embedding model; mounted as a volume
CACHE_DIR=/cache
HF_HOME=/cache/hf
# Re-run weekly (open data changes slowly); set RUN_ONCE=1 to run once and exit
# EXPORT_SEED_PATH=/cache/places.seed.json writes the documents to a file as well
INTERVAL_SECONDS=604800
