DB_URL=postgres://app:change-me@db:5432/app

# Comma separated: osm, wikidata, nid, commons, wroclaw_gis (city GIS, Wrocław only)
SOURCES=osm,wikidata,nid,commons,wroclaw_gis

# Cache for downloads and the embedding model; mounted as a volume
CACHE_DIR=/cache
HF_HOME=/cache/hf
# Re-run weekly (open data changes slowly); set RUN_ONCE=1 to run once and exit
# EXPORT_SEED_PATH=/cache/places.seed.json writes the documents to a file as well
INTERVAL_SECONDS=604800
