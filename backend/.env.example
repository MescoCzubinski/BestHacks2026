PORT=8000
JWT_SECRET=change-me-to-a-long-random-string-32+chars

CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://app:change-me@db:5432/app

GRAPHHOPPER_URL=https://graphhopper.example
GRAPHHOPPER_TOKEN=change-me

EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# Shared with the fetcher, which embeds place texts through POST /api/embeddings. Unset = endpoint closed.
EMBEDDING_API_TOKEN=change-me-to-a-long-random-string

# IANA zone used to read opening hours
REGION_TIMEZONE=Europe/Warsaw

# Seeds the demo account anna@atlas.pl with this password. Unset = the account exists only outside production.
# DEMO_USER_PASSWORD=change-me-to-something-long
