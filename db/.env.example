# Owner of the schema: runs db/init on the first start of the volume, used by no service at runtime
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Login roles created by db/init/02-roles.sh; the same passwords go into the backend and fetcher URLs
BACKEND_DB_PASSWORD=change-me-backend
FETCHER_DB_PASSWORD=change-me-fetcher
